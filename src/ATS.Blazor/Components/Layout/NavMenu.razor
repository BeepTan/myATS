@using ATS.Blazor.Services
@inject RoleStateService RoleState
@implements IDisposable

<div class="top-row ps-3 navbar navbar-dark">
    <div class="container-fluid">
        <a class="navbar-brand" href="">myATS AI Portal</a>
    </div>
</div>

<input type="checkbox" title="Navigation menu" class="navbar-toggler" />

<div class="nav-scrollable" onclick="document.querySelector('.navbar-toggler').click()">
    <nav class="nav flex-column">
        <div class="nav-item px-3">
            <NavLink class="nav-link" href="" Match="NavLinkMatch.All">
                <span class="bi bi-house-door-fill" aria-hidden="true"></span> Role Selection
            </NavLink>
        </div>

        @if (RoleState.IsCandidate || RoleState.IsAdmin)
        {
            <div class="nav-item px-3 mt-2">
                <div class="text-uppercase text-secondary px-3 py-1 small fw-bold">Candidate Portal</div>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="apply">
                    <span class="bi bi-file-earmark-person-fill" aria-hidden="true"></span> Apply / Submit Resume
                </NavLink>
            </div>
        }

        @if (RoleState.IsAdmin)
        {
            <div class="nav-item px-3 mt-3">
                <div class="text-uppercase text-secondary px-3 py-1 small fw-bold">Recruiter Admin</div>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/jobs">
                    <span class="bi bi-briefcase-fill" aria-hidden="true"></span> Job Rubrics & Thresholds
                </NavLink>
            </div>

            <div class="nav-item px-3">
                <NavLink class="nav-link" href="admin/candidates">
                    <span class="bi bi-trophy-fill" aria-hidden="true"></span> Ranked Candidates
                </NavLink>
            </div>
        }
    </nav>
</div>

@code {
    protected override void OnInitialized()
    {
        RoleState.OnChange += StateHasChanged;
    }

    public void Dispose()
    {
        RoleState.OnChange -= StateHasChanged;
    }
}
