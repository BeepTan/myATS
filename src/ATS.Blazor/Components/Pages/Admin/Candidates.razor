@page "/admin/candidates"
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using ATS.Blazor.Data
@using ATS.Blazor.Data.Entities
@using ATS.Blazor.Models
@using ATS.Blazor.Services
@inject AtsDbContext DbContext
@inject IEvaluationQueue EvaluationQueue
@inject RoleStateService RoleState
@inject FastAiClientService FastAiClient
@inject NavigationManager Navigation
@rendermode InteractiveServer

<PageTitle>Admin - Candidate Leaderboard & AI Ranking</PageTitle>

<div class="container-fluid py-4">
    @if (!RoleState.IsAdmin)
    {
        <div class="row justify-content-center py-5">
            <div class="col-md-7">
                <div class="card shadow border-danger text-center p-5">
                    <div class="card-body">
                        <div class="text-danger mb-3">
                            <i class="bi bi-shield-lock-fill display-3"></i>
                        </div>
                        <h3 class="fw-bold text-danger mb-2">Access Restricted</h3>
                        <p class="text-muted mb-4 lead">
                            This section is reserved for Recruiters and Administrators. You are currently in <strong>@(RoleState.HasRole ? "Candidate" : "Unselected")</strong> mode.
                        </p>
                        <div class="d-flex justify-content-center gap-3">
                            <button class="btn btn-danger btn-lg px-4" @onclick="() => RoleState.SelectRole(AppRole.Admin)">
                                <i class="bi bi-shield-check me-2"></i>Switch to Admin Role
                            </button>
                            <a href="/" class="btn btn-outline-secondary btn-lg px-4">
                                Back to Role Selection
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h3 class="fw-bold mb-1"><i class="bi bi-trophy me-2 text-warning"></i>Ranked Candidates Leaderboard</h3>
                <p class="text-muted mb-0">AI-ranked candidates based on job rubrics, weighted scoring, and minimum passing thresholds.</p>
            </div>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadApplicationsAsync">
                    <i class="bi bi-arrow-clockwise me-1"></i> Refresh Leaderboard
                </button>
            </div>
        </div>

        @if (!string.IsNullOrEmpty(actionNotice))
        {
            <div class="alert alert-info alert-dismissible fade show shadow-sm" role="alert">
                <i class="bi bi-info-circle-fill me-2"></i> @actionNotice
                <button type="button" class="btn-close" @onclick="() => actionNotice = null"></button>
            </div>
        }

        <!-- Microservice & OpenAI API Key Status Indicator -->
        @if (healthStatus != null)
        {
            @if (!healthStatus.IsOnline)
            {
                <div class="card border-danger shadow-sm mb-4">
                    <div class="card-body p-3 bg-danger-subtle d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-hdd-network-fill text-danger fs-3 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold text-danger">AI Microservice: OFFLINE</h6>
                                <small class="text-danger-emphasis">
                                    Cannot connect to Python FastAPI microservice (<code>http://localhost:8000</code>). Background candidate evaluations are paused and flagged for manual recruiter review.
                                </small>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-danger" @onclick="CheckHealthStatusAsync">
                            <i class="bi bi-arrow-clockwise me-1"></i> Re-check Service
                        </button>
                    </div>
                </div>
            }
            else if (healthStatus.HasApiKeyIssue)
            {
                <div class="card border-warning shadow-sm mb-4">
                    <div class="card-body p-3 bg-warning-subtle d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center">
                            <i class="bi bi-key-fill text-warning-emphasis fs-3 me-3"></i>
                            <div>
                                <h6 class="mb-0 fw-bold text-warning-emphasis">
                                    AI Microservice Online &mdash; OpenAI API Key Issue
                                </h6>
                                <small class="text-secondary">
                                    API Key Status: <span class="badge bg-warning text-dark">@(healthStatus.OpenAiKeyStatus == "missing" ? "Missing Key" : "Invalid Key Format")</span>.
                                    OpenAI project API keys must start with <code>sk-proj-</code>. Update <code>OPENAI_API_KEY</code> in <code>src/ats_ai_service/.env</code> to activate automated evaluations.
                                </small>
                            </div>
                        </div>
                        <button class="btn btn-sm btn-outline-warning text-dark" @onclick="CheckHealthStatusAsync">
                            <i class="bi bi-arrow-clockwise me-1"></i> Re-check Key
                        </button>
                    </div>
                </div>
            }
            else
            {
                <div class="card border-success shadow-sm mb-4">
                    <div class="card-body py-2 px-3 bg-success-subtle d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center small">
                            <i class="bi bi-check-circle-fill text-success fs-5 me-2"></i>
                            <span class="fw-bold text-success">AI Microservice Online</span>
                            <span class="text-muted mx-2">|</span>
                            <span class="text-success-emphasis">OpenAI API Key: <code>@healthStatus.OpenAiKeyPrefix</code> (Valid Format)</span>
                            <span class="text-muted mx-2">|</span>
                            <span class="text-muted">Vision: @healthStatus.Status | Rubric Scorer Active</span>
                        </div>
                        <button class="btn btn-sm btn-outline-success py-0 px-2" @onclick="CheckHealthStatusAsync" title="Refresh Health Probe">
                            <i class="bi bi-arrow-clockwise"></i>
                        </button>
                    </div>
                </div>
            }
        }

        <!-- Filters Bar -->
        <div class="card shadow-sm border-0 mb-4">
            <div class="card-body p-3">
                <div class="row g-3 align-items-center">
                    <div class="col-md-4">
                        <label class="form-label small fw-bold mb-1">Filter by Job Posting</label>
                        <select class="form-select form-select-sm" @bind="selectedJobFilter" @bind:after="ApplyFilter">
                            <option value="">All Job Postings</option>
                            @foreach (var job in jobs)
                            {
                                <option value="@job.Id.ToString()">@job.Title</option>
                            }
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Status Filter</label>
                        <select class="form-select form-select-sm" @bind="selectedStatusFilter" @bind:after="ApplyFilter">
                            <option value="All">All Statuses</option>
                            <option value="Qualified">Qualified (Passed Threshold)</option>
                            <option value="Rejected">Rejected (Below Threshold)</option>
                            <option value="Evaluating">Evaluating in Background</option>
                            <option value="ManualReviewNeeded">Manual Review Needed (Offline)</option>
                            <option value="PendingEvaluation">Pending Evaluation</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label small fw-bold mb-1">Min Score Filter: @minScoreFilter pts</label>
                        <input type="range" class="form-range" min="0" max="100" step="5" @bind="minScoreFilter" @bind:after="ApplyFilter" />
                    </div>
                    <div class="col-md-2 text-end">
                        <span class="badge bg-secondary">Total: @filteredApplications.Count candidates</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Candidate Ranking Table -->
        <div class="card shadow-sm border-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr>
                            <th style="width: 65px;">Rank</th>
                            <th>Candidate</th>
                            <th>Job Applied</th>
                            <th>Resume File</th>
                            <th>AI Score / 100</th>
                            <th>Evaluation Mode</th>
                            <th>Status</th>
                            <th>Applied On</th>
                            <th class="text-end" style="min-width: 200px;">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (!filteredApplications.Any())
                        {
                            <tr>
                                <td colspan="9" class="text-center py-4 text-muted">
                                    <i class="bi bi-inbox fs-3 d-block mb-2"></i>
                                    No candidates match the specified filters.
                                </td>
                            </tr>
                        }
                        else
                        {
                            int rank = 1;
                            @foreach (var app in filteredApplications)
                            {
                                var eval = app.EvaluationResult;
                                <tr>
                                    <td>
                                        @if (rank == 1)
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-trophy-fill"></i> #1</span>
                                        }
                                        else if (rank == 2)
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-award-fill"></i> #2</span>
                                        }
                                        else if (rank == 3)
                                        {
                                            <span class="badge bg-info text-dark"><i class="bi bi-award-fill"></i> #3</span>
                                        }
                                        else
                                        {
                                            <span class="fw-bold text-muted ps-2">#@rank</span>
                                        }
                                    </td>
                                    <td>
                                        <div class="fw-bold">@app.Applicant?.FullName</div>
                                        <small class="text-muted">@app.Applicant?.Email</small>
                                    </td>
                                    <td>
                                        <span class="badge bg-light text-dark border">@app.JobPosting?.Title</span>
                                        <div class="small text-muted">Threshold: @app.JobPosting?.MinPassingScore pts</div>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(app.ResumeFileName))
                                        {
                                            <a href="/api/resumes/@app.Id/download" target="_blank" class="btn btn-sm btn-outline-secondary" title="View/Download @app.ResumeFileName">
                                                <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                                                <span class="d-inline-block text-truncate" style="max-width: 130px; vertical-align: bottom;">
                                                    @app.ResumeFileName
                                                </span>
                                            </a>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">No file</span>
                                        }
                                    </td>
                                    <td style="width: 170px;">
                                        @if (eval != null && eval.EvaluationMode != "service_unavailable")
                                        {
                                            <div class="d-flex align-items-center">
                                                <span class="fw-bold me-2">@eval.TotalScore.ToString("F1")</span>
                                                <div class="progress flex-grow-1" style="height: 8px;">
                                                    <div class="progress-bar @(eval.PassedThreshold ? "bg-success" : "bg-danger")"
                                                         role="progressbar"
                                                         style="width: @Math.Min(100, (int)eval.TotalScore)%;"></div>
                                                </div>
                                            </div>
                                        }
                                        else if (app.Status == ApplicationStatus.Evaluating)
                                        {
                                            <span class="text-primary small"><i class="spinner-border spinner-border-sm me-1"></i> Scoring...</span>
                                        }
                                        else if (app.Status == ApplicationStatus.ManualReviewNeeded || (eval != null && eval.EvaluationMode == "service_unavailable"))
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-pause-circle me-1"></i> Paused (0.0)</span>
                                        }
                                        else
                                        {
                                            <span class="text-muted small"><i class="bi bi-hourglass-split"></i> In Queue</span>
                                        }
                                    </td>
                                    <td>
                                        @if (eval != null)
                                        {
                                            @if (eval.EvaluationMode == "ai_rubric")
                                            {
                                                <span class="badge bg-primary-subtle text-primary border border-primary-subtle">
                                                    <i class="bi bi-stars me-1"></i> OpenAI Rubric
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary text-white">
                                                    <i class="bi bi-pause-circle me-1"></i> Paused / Manual Review
                                                </span>
                                            }
                                        }
                                        else
                                        {
                                            <span class="badge bg-light text-muted border">-</span>
                                        }
                                    </td>
                                    <td>
                                        @if (app.Status == ApplicationStatus.Qualified)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i> Qualified</span>
                                        }
                                        else if (app.Status == ApplicationStatus.Rejected)
                                        {
                                            <span class="badge bg-danger"><i class="bi bi-x-circle me-1"></i> Filtered Out</span>
                                        }
                                        else if (app.Status == ApplicationStatus.Evaluating)
                                        {
                                            <span class="badge bg-info text-dark"><i class="bi bi-gear-wide-connected me-1"></i> Evaluating</span>
                                        }
                                        else if (app.Status == ApplicationStatus.ManualReviewNeeded)
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-exclamation-circle me-1"></i> Manual Review Needed</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning text-dark"><i class="bi bi-clock me-1"></i> @app.Status</span>
                                        }
                                    </td>
                                    <td class="small text-muted">
                                        @app.AppliedAt.ToLocalTime().ToString("g")
                                    </td>
                                    <td class="text-end">
                                        @if (eval != null)
                                        {
                                            <button class="btn btn-sm btn-outline-primary me-1" @onclick="() => ViewEvaluationDetails(app)">
                                                <i class="bi bi-eye"></i> Details
                                            </button>
                                        }
                                        <button class="btn btn-sm btn-outline-warning me-1"
                                                @onclick="() => ReEvaluateApplicationAsync(app)"
                                                disabled="@(app.Status == ApplicationStatus.Evaluating)"
                                                title="Re-run AI Rubric Evaluation against current criteria">
                                            <i class="bi bi-arrow-repeat"></i> Re-evaluate
                                        </button>
                                        <button class="btn btn-sm btn-outline-danger"
                                                @onclick="() => DeleteApplicationAsync(app)"
                                                title="Delete candidate application">
                                            <i class="bi bi-trash"></i> Delete
                                        </button>
                                    </td>
                                </tr>
                                rank++;
                            }
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

<!-- Evaluation Drill-Down Modal -->
@if (selectedApp != null && selectedApp.EvaluationResult != null)
{
    var ev = selectedApp.EvaluationResult;
    <div class="modal fade show d-block" tabindex="-1" style="background-color: rgba(0,0,0,0.5);">
        <div class="modal-dialog modal-lg">
            <div class="modal-content border-0 shadow">
                <div class="modal-header @(ev.PassedThreshold ? "bg-success" : "bg-danger") text-white">
                    <h5 class="modal-title fw-bold">
                        <i class="bi bi-person-badge me-2"></i>@selectedApp.Applicant?.FullName — Evaluation Report
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDetailsModal"></button>
                </div>
                <div class="modal-body p-4">
                    <!-- Top Score Summary Card -->
                    <div class="p-3 bg-light rounded d-flex justify-content-between align-items-center mb-4">
                        <div>
                            <div class="text-muted small">Total Evaluation Score</div>
                            <h2 class="fw-bold mb-0 @(ev.PassedThreshold ? "text-success" : "text-danger")">
                                @ev.TotalScore.ToString("F1") <span class="fs-6 text-muted">/ 100</span>
                            </h2>
                        </div>
                        <div class="text-end">
                            <span class="badge @(ev.PassedThreshold ? "bg-success" : "bg-danger") fs-6 px-3 py-2">
                                @(ev.PassedThreshold ? "PASSED THRESHOLD" : "BELOW CUTOFF THRESHOLD")
                            </span>
                            <div class="small text-muted mt-1">Passing requirement: @ev.MinPassingScore pts</div>
                        </div>
                    </div>

                    @if (!string.IsNullOrEmpty(ev.WarningMessage))
                    {
                        <div class="alert alert-warning small mb-3">
                            <i class="bi bi-info-circle-fill me-1"></i> @ev.WarningMessage
                        </div>
                    }

                    <!-- Reasoning Summary -->
                    <div class="mb-4">
                        <h6 class="fw-bold">AI Rationale Summary</h6>
                        <p class="text-muted p-3 bg-light rounded border-start border-4 border-primary">
                            @ev.ReasoningSummary
                        </p>
                    </div>

                    <!-- Strengths and Weaknesses -->
                    <div class="row g-3 mb-4">
                        <div class="col-md-6">
                            <h6 class="fw-bold text-success"><i class="bi bi-check2-circle me-1"></i> Identified Strengths</h6>
                            <ul class="list-group list-group-flush small">
                                @foreach (var strength in ParseJsonList(ev.StrengthsJson))
                                {
                                    <li class="list-group-item px-0 py-1 text-muted">✔ @strength</li>
                                }
                            </ul>
                        </div>
                        <div class="col-md-6">
                            <h6 class="fw-bold text-danger"><i class="bi bi-dash-circle me-1"></i> Areas for Improvement / Gaps</h6>
                            <ul class="list-group list-group-flush small">
                                @foreach (var weakness in ParseJsonList(ev.WeaknessesJson))
                                {
                                    <li class="list-group-item px-0 py-1 text-muted">✖ @weakness</li>
                                }
                            </ul>
                        </div>
                    </div>

                    <!-- Category Score Breakdown -->
                    <h6 class="fw-bold mb-2">Category Score Breakdown</h6>
                    <div class="row g-2">
                        @foreach (var kv in ParseCategoryScores(ev.CategoryScoresJson))
                        {
                            <div class="col-md-6">
                                <div class="p-2 border rounded bg-light d-flex justify-content-between align-items-center">
                                    <span class="small fw-semibold">@kv.Key</span>
                                    <span class="badge bg-primary">@kv.Value.ToString("F1")%</span>
                                </div>
                            </div>
                        }
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" @onclick="CloseDetailsModal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<JobPosting> jobs = new();
    private List<Application> allApplications = new();
    private List<Application> filteredApplications = new();

    private string selectedJobFilter = "";
    private string selectedStatusFilter = "All";
    private double minScoreFilter = 0;
    private string? actionNotice;

    private Application? selectedApp;
    private AiServiceHealthDto? healthStatus;

    protected override async Task OnInitializedAsync()
    {
        await CheckHealthStatusAsync();
        await LoadApplicationsAsync();
    }

    private async Task CheckHealthStatusAsync()
    {
        healthStatus = await FastAiClient.CheckHealthAsync();
    }

    private async Task LoadApplicationsAsync()
    {
        await CheckHealthStatusAsync();
        jobs = await DbContext.JobPostings.ToListAsync();

        allApplications = await DbContext.Applications
            .Include(a => a.Applicant)
            .Include(a => a.JobPosting)
            .Include(a => a.EvaluationResult)
            .OrderByDescending(a => a.EvaluationResult != null ? a.EvaluationResult.TotalScore : 0)
            .ThenByDescending(a => a.AppliedAt)
            .ToListAsync();

        ApplyFilter();
    }

    private void ApplyFilter()
    {
        filteredApplications = allApplications.Where(a =>
        {
            if (!string.IsNullOrEmpty(selectedJobFilter) && a.JobPostingId.ToString() != selectedJobFilter)
                return false;

            if (selectedStatusFilter != "All")
            {
                if (selectedStatusFilter == "Qualified" && a.Status != ApplicationStatus.Qualified)
                    return false;
                if (selectedStatusFilter == "Rejected" && a.Status != ApplicationStatus.Rejected)
                    return false;
                if (selectedStatusFilter == "Evaluating" && a.Status != ApplicationStatus.Evaluating)
                    return false;
                if (selectedStatusFilter == "ManualReviewNeeded" && a.Status != ApplicationStatus.ManualReviewNeeded)
                    return false;
                if (selectedStatusFilter == "PendingEvaluation" && a.Status != ApplicationStatus.PendingEvaluation)
                    return false;
            }

            if (minScoreFilter > 0)
            {
                if (a.EvaluationResult == null || a.EvaluationResult.TotalScore < minScoreFilter)
                    return false;
            }

            return true;
        }).ToList();
    }

    private async Task ReEvaluateApplicationAsync(Application app)
    {
        try
        {
            app.Status = ApplicationStatus.Evaluating;
            await DbContext.SaveChangesAsync();
            await EvaluationQueue.QueueEvaluationAsync(app.Id);

            actionNotice = $"Enqueued {app.Applicant?.FullName} for re-evaluation against the job rubric. The score will update shortly.";
            await LoadApplicationsAsync();
        }
        catch (Exception ex)
        {
            actionNotice = $"Error re-evaluating: {ex.Message}";
        }
    }

    private async Task DeleteApplicationAsync(Application app)
    {
        try
        {
            if (!string.IsNullOrEmpty(app.ResumeFilePath) && File.Exists(app.ResumeFilePath))
            {
                try { File.Delete(app.ResumeFilePath); } catch { }
            }

            DbContext.Applications.Remove(app);
            await DbContext.SaveChangesAsync();

            actionNotice = $"Application record for '{app.Applicant?.FullName}' deleted successfully.";
            await LoadApplicationsAsync();
        }
        catch (Exception ex)
        {
            actionNotice = $"Error deleting application: {ex.Message}";
        }
    }

    private void ViewEvaluationDetails(Application app)
    {
        selectedApp = app;
    }

    private void CloseDetailsModal()
    {
        selectedApp = null;
    }

    private List<string> ParseJsonList(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<List<string>>(json) ?? new();
        }
        catch
        {
            return new();
        }
    }

    private Dictionary<string, double> ParseCategoryScores(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<Dictionary<string, double>>(json) ?? new();
        }
        catch
        {
            return new();
        }
    }
}
