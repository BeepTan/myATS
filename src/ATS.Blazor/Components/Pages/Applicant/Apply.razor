@page "/apply"
@using System.Text.Json
@using Microsoft.EntityFrameworkCore
@using ATS.Blazor.Data
@using ATS.Blazor.Data.Entities
@using ATS.Blazor.Models
@using ATS.Blazor.Services
@inject AtsDbContext DbContext
@inject IAiParserService AiParserService
@inject IEvaluationQueue EvaluationQueue
@inject NavigationManager Navigation
@inject RoleStateService RoleState
@inject FastAiClientService FastAiClient
@inject IWebHostEnvironment WebHostEnvironment
@rendermode InteractiveServer

<PageTitle>Apply for Job - myATS</PageTitle>

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card shadow-sm border-0 mb-4">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0"><i class="bi bi-file-earmark-arrow-up me-2"></i>Job Application & AI Resume Auto-Fill</h4>
                </div>
                <div class="card-body p-4">
                    @if (jobs == null)
                    {
                        <div class="d-flex align-items-center">
                            <div class="spinner-border text-primary me-2" role="status"></div>
                            <span>Loading available positions...</span>
                        </div>
                    }
                    else if (!jobs.Any())
                    {
                        <div class="alert alert-info">No active job postings found. An admin can create one in the Admin portal.</div>
                    }
                    else
                    {
                        <!-- Step 1: Select Position -->
                        <div class="mb-4">
                            <label class="form-label fw-bold">1. Select Position to Apply For</label>
                            <select class="form-select form-select-lg" @bind="selectedJobId">
                                @foreach (var job in jobs)
                                {
                                    <option value="@job.Id">@job.Title (@job.Department)</option>
                                }
                            </select>
                            @if (currentJob != null)
                            {
                                <div class="mt-2 p-3 bg-light rounded small">
                                    <strong>Requirements:</strong> @currentJob.Description
                                    <br />
                                    <span class="badge bg-secondary mt-1">Required: @currentJob.RequiredSkills</span>
                                </div>
                            }
                        </div>

                        <!-- Step 2: Upload Resume -->
                        <div class="mb-4 p-4 border rounded bg-light text-center">
                            <h5 class="fw-bold mb-2">2. Upload Your Resume</h5>
                            <p class="text-muted small mb-3">Upload your PDF or image resume. Our AI will automatically parse and fill out your application fields below.</p>

                            <!-- AI Service Status Indicator (Sanitized for Applicants) -->
                            @if (healthStatus != null)
                            {
                                @if (!healthStatus.IsOnline || healthStatus.HasApiKeyIssue)
                                {
                                    <div class="alert alert-warning d-flex align-items-center mb-3 py-2 px-3 small text-start">
                                        <i class="bi bi-info-circle me-2 text-warning fs-5"></i>
                                        <div>
                                            <strong>Notice:</strong> Auto-fill feature is temporarily unavailable at this moment. You may still upload your resume and fill in your details below manually.
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="alert alert-success d-flex align-items-center mb-3 py-2 px-3 small text-start">
                                        <i class="bi bi-stars me-2 text-success fs-5"></i>
                                        <div>
                                            <strong>AI Auto-Fill Ready:</strong> Uploading your resume will automatically extract and populate your application fields below.
                                        </div>
                                    </div>
                                }
                            }

                            <InputFile OnChange="HandleFileUpload" class="form-control" accept=".pdf,.png,.jpg,.jpeg" disabled="@isExtracting" />

                            @if (isExtracting)
                            {
                                <div class="mt-3 text-primary">
                                    <div class="spinner-border spinner-border-sm me-2" role="status"></div>
                                    <strong>Analyzing document with AI Vision parser... Please wait.</strong>
                                </div>
                            }
                        </div>

                        <!-- User-Facing Friendly Alert Banner -->
                        @if (!string.IsNullOrEmpty(parsingNotice))
                        {
                            <div class="alert alert-warning d-flex align-items-center shadow-sm" role="alert">
                                <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                                <div>
                                    <strong>Notice:</strong> @parsingNotice
                                </div>
                            </div>
                        }

                        <!-- Step 3: Verified Application Fields -->
                        <div class="border-top pt-4">
                            <h5 class="fw-bold mb-3">3. Review & Verify Your Profile Information</h5>

                            <EditForm Model="@applicantModel" OnValidSubmit="HandleSubmitApplication">
                                <DataAnnotationsValidator />
                                <ValidationSummary class="text-danger small mb-3" />

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Full Name *</label>
                                        <InputText class="form-control" @bind-Value="applicantModel.FullName" placeholder="e.g. Jane Doe" required />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Email Address *</label>
                                        <InputText class="form-control" @bind-Value="applicantModel.Email" placeholder="jane.doe@example.com" type="email" required />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Phone Number</label>
                                        <InputText class="form-control" @bind-Value="applicantModel.Phone" placeholder="+1 (555) 019-2834" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">Location (City, Country)</label>
                                        <InputText class="form-control" @bind-Value="applicantModel.Location" placeholder="Seattle, WA" />
                                    </div>
                                </div>

                                <div class="row g-3 mb-3">
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">LinkedIn Profile URL</label>
                                        <InputText class="form-control" @bind-Value="applicantModel.LinkedInUrl" placeholder="https://linkedin.com/in/username" />
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label fw-semibold">GitHub Profile URL</label>
                                        <InputText class="form-control" @bind-Value="applicantModel.GitHubUrl" placeholder="https://github.com/username" />
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="form-label fw-semibold">Professional Summary</label>
                                    <InputTextArea class="form-control" rows="3" @bind-Value="applicantModel.Summary" placeholder="Brief summary of your expertise and background..." />
                                </div>

                                <div class="mb-4">
                                    <label class="form-label fw-semibold">Technical & Professional Skills (comma-separated)</label>
                                    <InputText class="form-control" @bind-Value="applicantModel.Skills" placeholder="C#, .NET 9, Python, FastAPI, Docker, SQLite" />
                                </div>

                                @if (submissionSuccess)
                                {
                                    <div class="alert alert-success d-flex align-items-center shadow-sm">
                                        <i class="bi bi-check-circle-fill me-2 fs-4"></i>
                                        <div>
                                            <h6 class="mb-0 fw-bold">Application Submitted Successfully!</h6>
                                            <div class="small">Your resume and profile details have been received. Our recruitment team will review your application.</div>
                                        </div>
                                    </div>
                                }

                                <div class="d-grid gap-2">
                                    <button type="submit" class="btn btn-success btn-lg" disabled="@(isSubmitting || isExtracting)">
                                        @if (isSubmitting)
                                        {
                                            <span class="spinner-border spinner-border-sm me-2"></span>
                                            <span>Submitting Application...</span>
                                        }
                                        else
                                        {
                                            <span><i class="bi bi-send-check me-2"></i>Confirm & Submit Application</span>
                                        }
                                    </button>
                                </div>
                            </EditForm>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private List<JobPosting>? jobs;
    private Guid selectedJobId;
    private JobPosting? currentJob => jobs?.FirstOrDefault(j => j.Id == selectedJobId);

    private Applicant applicantModel = new();
    private ResumeDataDto parsedResume = new();

    private bool isExtracting = false;
    private bool isSubmitting = false;
    private bool submissionSuccess = false;
    private string? parsingNotice;
    private string uploadedFileName = "resume.pdf";
    private string savedPhysicalPath = string.Empty;
    private AiServiceHealthDto? healthStatus;

    protected override async Task OnInitializedAsync()
    {
        if (!RoleState.HasRole)
        {
            RoleState.SelectRole(AppRole.Candidate);
        }

        healthStatus = await FastAiClient.CheckHealthAsync();

        jobs = await DbContext.JobPostings.Where(j => j.IsActive).ToListAsync();
        if (jobs.Any())
        {
            selectedJobId = jobs.First().Id;
        }
    }

    private async Task HandleFileUpload(InputFileChangeEventArgs e)
    {
        var file = e.File;
        if (file == null) return;

        isExtracting = true;
        parsingNotice = null;
        uploadedFileName = file.Name;

        try
        {
            // 1. Physically save resume file to wwwroot/uploads/resumes
            var uploadsDir = Path.Combine(WebHostEnvironment.WebRootPath ?? Path.Combine(Directory.GetCurrentDirectory(), "wwwroot"), "uploads", "resumes");
            Directory.CreateDirectory(uploadsDir);

            var safeFileName = $"{Guid.NewGuid():N}_{Path.GetFileName(file.Name)}";
            savedPhysicalPath = Path.Combine(uploadsDir, safeFileName);

            using (var fileSaveStream = File.Create(savedPhysicalPath))
            {
                await file.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024).CopyToAsync(fileSaveStream);
            }

            // 2. Read saved file stream to pass to AI parser
            using (var readStream = File.OpenRead(savedPhysicalPath))
            {
                parsedResume = await AiParserService.ParseResumeAsync(readStream, file.Name);
            }

            // 3. Auto-fill fields for applicant review
            if (parsedResume.PersonalInfo != null)
            {
                if (!string.IsNullOrWhiteSpace(parsedResume.PersonalInfo.FullName))
                    applicantModel.FullName = parsedResume.PersonalInfo.FullName;
                if (!string.IsNullOrWhiteSpace(parsedResume.PersonalInfo.Email))
                    applicantModel.Email = parsedResume.PersonalInfo.Email;
                if (!string.IsNullOrWhiteSpace(parsedResume.PersonalInfo.Phone))
                    applicantModel.Phone = parsedResume.PersonalInfo.Phone;
                if (!string.IsNullOrWhiteSpace(parsedResume.PersonalInfo.Location))
                    applicantModel.Location = parsedResume.PersonalInfo.Location;
                if (!string.IsNullOrWhiteSpace(parsedResume.PersonalInfo.LinkedInUrl))
                    applicantModel.LinkedInUrl = parsedResume.PersonalInfo.LinkedInUrl;
                if (!string.IsNullOrWhiteSpace(parsedResume.PersonalInfo.GitHubUrl))
                    applicantModel.GitHubUrl = parsedResume.PersonalInfo.GitHubUrl;
            }

            if (!string.IsNullOrWhiteSpace(parsedResume.Summary))
                applicantModel.Summary = parsedResume.Summary;

            if (parsedResume.Skills?.Any() == true)
                applicantModel.Skills = string.Join(", ", parsedResume.Skills);

            if (!string.IsNullOrEmpty(parsedResume.WarningMessage))
            {
                parsingNotice = "Auto-fill feature is temporarily unavailable at this moment. Please fill in your details manually.";
            }
        }
        catch (Exception)
        {
            parsingNotice = "Auto-fill feature is temporarily unavailable at this moment. Please fill in your details manually.";
        }
        finally
        {
            isExtracting = false;
        }
    }

    private async Task HandleSubmitApplication()
    {
        isSubmitting = true;
        submissionSuccess = false;

        try
        {
            // Save applicant profile
            applicantModel.ProfileJson = JsonSerializer.Serialize(parsedResume);
            DbContext.Applicants.Add(applicantModel);
            await DbContext.SaveChangesAsync();

            // Create application record referencing stored file path
            var app = new Application
            {
                JobPostingId = selectedJobId,
                ApplicantId = applicantModel.Id,
                ResumeFileName = uploadedFileName,
                ResumeFilePath = savedPhysicalPath,
                Status = ApplicationStatus.PendingEvaluation,
                AppliedAt = DateTime.UtcNow
            };

            DbContext.Applications.Add(app);
            await DbContext.SaveChangesAsync();

            // Dispatch asynchronous background evaluation
            await EvaluationQueue.QueueEvaluationAsync(app.Id);

            submissionSuccess = true;
        }
        catch (Exception)
        {
            parsingNotice = "Unable to submit application at this moment. Please verify your details and try again.";
        }
        finally
        {
            isSubmitting = false;
        }
    }
}

